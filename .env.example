# Konfigurasi Lingkungan ARTSPACE — Laravel 13 & PostgreSQL (OJT HEXA)
APP_NAME="ARTSPACE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Database Utama Wajib: PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=artspace
DB_USERNAME=postgres
DB_PASSWORD=

# Penyimpanan Berkas (Foto Profil & Foto Karya Seni)
FILESYSTEM_DISK=public

# Sesi & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
